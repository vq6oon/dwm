#!/bin/bash

# usage: theme [wallpaper]
# no argument = use the wallpaper saved by nitrogen

export PATH="$HOME/.local/bin:$PATH"

Wall="$1"
[ -z "$Wall" ] && Wall=$(grep -m1 '^file=' ~/.config/nitrogen/bg-saved.cfg | cut -d= -f2-)
Wall=$(realpath -- "$Wall" 2>/dev/null)
[ -f "$Wall" ] || { echo "wallpaper not found: $Wall" >&2; exit 1; }

[ -n "$1" ] && nitrogen --set-zoom-fill "$Wall" --save

wal -i "$Wall" -n -s -t -q 2>/dev/null
theme-accent "$Wall"
theme-neutral "$Wall"
xrdb -merge ~/.cache/wal/dwm-xres
xdotool key super+shift+F5
pkill -USR1 -x kitty
theme-dunst
pkill -f sxstatus; sxstatus &
command -v pywalfox >/dev/null && timeout 5 pywalfox update >/dev/null 2>&1 &
